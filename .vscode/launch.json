{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug STM32 via DAPLink",
      "type": "cortex-debug",
      "request": "launch",
      "servertype": "pyocd",
      "cwd": "${workspaceFolder}",
      "executable": "${workspaceFolder}/build/Debug/FK407-template.elf",
      "targetId": "${config:fk407.pyocdTarget}",
      "serverArgs": ["-O", "cmsis_dap.prefer_v1=true"],
      "gdbPath": "${config:fk407.gdbPath}",
      "runToEntryPoint": "main",
      "preLaunchTask": "Build Debug"
    }
  ]
}
